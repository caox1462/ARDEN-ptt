From: PTT-dev
Subject: [PATCH] ramips: enable ES8311 audio codec on EKH03 boards

The EKH03 boards (MorseMicro eval / Heltec HT-HD01 / H7608 V2) expose the
MT7628 I2S peripheral on GPIO0-3 (SoM pins 17-20). A ES8311 codec plus
NS4150B amplifier module is attached to the I2S bus and I2C0 (addr 0x18).

This wires up the codec via device-tree and the generic simple-audio-card
machine driver so the kernel registers a sound card at boot. All drivers
are built as the kmod-sound-ralink-es8311 package added to
target/linux/ramips/modules.mk:

  - remove the "morse-mode-switch" gpio-export on gpio2 (I2S_WS pin)
  - mux GPIO0-3 to their I2S function via the i2s_pins pinctrl group
  - add the ES8311 codec node on i2c0 (MCLK not wired: the codec driver
    derives its internal clock from BCLK when no mclk is specified)
  - register a simple-audio-card with the ralink I2S DAI as bit-clock and
    frame master and the codec as slave

The package is enabled in configs/ramips-mt76x8-morse.config together
with alsa-utils (amixer/aplay/speaker-test) for user-space testing.

--- a/target/linux/ramips/dts/mt7628an_morse_ekh03.dtsi
+++ b/target/linux/ramips/dts/mt7628an_morse_ekh03.dtsi
@@ -45,15 +45,19 @@
 		};
 	};
 
-	gpio-export {
-		compatible = "gpio-export";
-		#size-cells = <0>;
-
-		gpio2 {
-			// J4 header attached to I2S_WS gpio2.
-			// High value means STA, low AP.
-			gpio-export,name = "morse-mode-switch";
-			gpios = <&gpio 2 GPIO_ACTIVE_HIGH>;
+	sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "ES8311";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,bitclock-master = <&sound_cpu>;
+		simple-audio-card,frame-master = <&sound_cpu>;
+
+		sound_cpu: simple-audio-card,cpu {
+			sound-dai = <&i2s>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&es8311>;
 		};
 	};
 
@@ -135,10 +139,18 @@
 
 &i2c {
 	status = "okay";
+
+	es8311: es8311@18 {
+		compatible = "everest,es8311";
+		reg = <0x18>;
+		#sound-dai-cells = <0>;
+	};
 };
 
 &i2s {
 	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2s_pins>;
 };
 
 &gdma {
--- a/target/linux/ramips/modules.mk
+++ b/target/linux/ramips/modules.mk
@@ -172,3 +172,27 @@
 endef
 
 $(eval $(call KernelPackage,keyboard-sx951x))
+
+define KernelPackage/sound-ralink-es8311
+  SUBMENU:=Other modules
+  TITLE:=Ralink I2S + ES8311 codec sound card
+  DEPENDS:=@TARGET_ramips_mt76x8 +kmod-sound-soc-core +kmod-i2c-mt7628 +kmod-dma-ralink
+  KCONFIG:= \
+	CONFIG_SND_RALINK_SOC_I2S \
+	CONFIG_SND_SOC_ES8311 \
+	CONFIG_SND_SIMPLE_CARD \
+	CONFIG_SND_SIMPLE_CARD_UTILS
+  FILES:= \
+	$(LINUX_DIR)/sound/soc/ralink/snd-soc-ralink-i2s.ko \
+	$(LINUX_DIR)/sound/soc/codecs/snd-soc-es8311.ko \
+	$(LINUX_DIR)/sound/soc/generic/snd-soc-simple-card.ko \
+	$(LINUX_DIR)/sound/soc/generic/snd-soc-simple-card-utils.ko
+  AUTOLOAD:=$(call AutoLoad,90,snd-soc-simple-card snd-soc-ralink-i2s snd-soc-es8311)
+endef
+
+define KernelPackage/sound-ralink-es8311/description
+ ES8311 audio codec over the MT7628 I2S interface. The sound card is
+ registered from device-tree via the simple-audio-card binding.
+endef
+
+$(eval $(call KernelPackage,sound-ralink-es8311))
